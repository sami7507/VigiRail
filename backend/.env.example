# VigiRail API — environment template
# Copy to `.env` and adjust. NEVER commit a real .env file.

# Runtime environment: development | production
VIGIRAIL_ENVIRONMENT=development

# JWT signing key — REQUIRED in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
VIGIRAIL_SECRET_KEY=

# Token lifetime (minutes)
VIGIRAIL_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Login rate limit: attempts per window
VIGIRAIL_LOGIN_RATE_LIMIT=10
VIGIRAIL_LOGIN_RATE_WINDOW=60

# Allowed browser origins (comma-separated or JSON list)
VIGIRAIL_CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
